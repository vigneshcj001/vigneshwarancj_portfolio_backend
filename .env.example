# Required: Groq generates final natural-language answers.
GROQ_API_KEY=gsk_replace_me

# Required for Laya routing. Create separate Laya key; never reuse Groq key.
LAYA_API_KEY=replace_with_laya_key
LAYA_BASE_URL=https://laya-production-b57e.up.railway.app
LAYA_TIMEOUT_SECONDS=8

# Optional platform features.
DATABASE_URL=
ADMIN_API_KEY=
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=portfolio-assistant

# Deployment / operations (optional).
# Reverse proxies in front of the API that append to X-Forwarded-For.
# Set to 1 on Render/Railway so rate limits apply per visitor, not per proxy.
TRUSTED_PROXY_COUNT=0
# Comma-separated extra CORS origins for local frontend development.
EXTRA_ALLOWED_ORIGINS=http://localhost:1234,http://127.0.0.1:4173
# Raises the GitHub API limit used by /api/proof from 60 to 5000 req/hour.
GITHUB_TOKEN=

# Model and data-handling settings (optional; defaults shown).
GROQ_MODEL=openai/gpt-oss-120b
# 0.2-0.4 favours strict grounding; see AI_SYSTEM_DESIGN.md.
ANSWER_TEMPERATURE=0.65
ANSWER_CACHE_DAYS=7
SESSION_RETENTION_DAYS=30
